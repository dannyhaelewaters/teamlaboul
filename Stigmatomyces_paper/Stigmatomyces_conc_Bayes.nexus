	CHARSET Stigmatomyces_outgroup_LSU_aligned_fasta = 1-1019;
	CHARSET Stigmatomyces_outgroup_SSU_fasta = 1020-2776;
	CHARSET Stigmatomyces_outgroup_TEF1_aligned_fasta = 2777-3393;

begin mrbayes; 

	charset part1LSU = 1-1019;
  	charset part2SSU = 1020-2776;
 	charset part3TEF1_TEF2 = 2777-3393\3  2778-3393\3;
  	charset part4TEF3 = 2779-3393\3;

	partition favored = 4: part1LSU, part2SSU, part3TEF1_TEF2, part4TEF3;
	set partition = favored;

	unlink revmat=(all) statefreq=(all) shape=(all) pinvar=(all);
  	prset applyto=(all) ratepr=variable;

	lset applyto=(1) nst=6 rates=invgamma ngammacat=4;
	prset applyto=(1) statefreqpr=fixed(empirical);

	lset applyto=(2) nst=6 rates=invgamma ngammacat=4;
	prset applyto=(2) statefreqpr=fixed(empirical);

	lset applyto=(3) nst=2 rates=invgamma ngammacat=4;

	lset applyto=(4) nst=6 rates=invgamma ngammacat=4;
 	prset applyto=(4) statefreqpr=fixed(empirical);
	
	mcmcp printfreq=1000 samplefreq=1000 nruns=4 nchains=4 ngen=10000000;
	mcmc;
end;