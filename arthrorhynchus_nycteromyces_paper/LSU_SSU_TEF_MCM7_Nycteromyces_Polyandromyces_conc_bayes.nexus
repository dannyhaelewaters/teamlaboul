        beaglesse=no;
    charset LSU = 1-947;
    charset MCM7_1_SSU_TEF_1 = 948-1573\3  1574-2140  2141-2762\3;
	charset MCM7_2_TEF_3 = 949-1573\3  2143-2762\3;
	charset MCM7_3 = 950-1573\3;
	charset TEF_2 = 2142-2762\3;
    partition favored = 5: LSU, MCM7_1_SSU_TEF_1, MCM7_2_TEF_3, MCM7_3, TEF_2;
    set partition=favored;
    unlink statefreq=(all) revmat=(all) shape=(all) pinvar=(all);
    prset applyto=(all) ratepr=variable;

    lset applyto=(1) nst=6 rates=gamma ngammacat=4;
    prset applyto=(1) statefreqpr=fixed(empirical);
	
    lset applyto=(2) nst=2 rates=gamma ngammacat=4;
    prset applyto=(2) statefreqpr=fixed(empirical);

    lset applyto=(3) nst=2 rates=propinv;

    lset applyto=(4) nst=2 rates=propinv;
    prset applyto=(4) statefreqpr=fixed(empirical);

    lset applyto=(5) nst=6 rates=invgamma ngammacat=4;
    prset applyto=(5) statefreqpr=fixed(empirical);
    mcmc
        nruns=2
        nchains=4
        ngen=100000000
        samplefreq=1000
        printfreq=1000
        diagnfreq=5000;
    sump burninfrac=0.25;
    sumt burninfrac=0.25;
END;